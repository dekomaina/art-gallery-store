PORT=3001
NODE_ENV=development
PUBLIC_URL=https://your-site.vercel.app
ALLOWED_ORIGIN=https://your-site.vercel.app
ADMIN_PASSWORD=choose-a-long-password

# Supabase -> Project Settings -> API Keys. Use the SECRET / service_role key here (server only).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# M-Pesa Daraja (sandbox shown)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_SECRET=put-a-long-random-string-here

# PayPal (sandbox shown)
PAYPAL_ENV=sandbox
